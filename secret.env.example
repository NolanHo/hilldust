# Copy to secret.env and chmod 600. secret.env is gitignored.
HILLSTONE_SERVER=vpn.example.com:10443
HILLSTONE_USER=user@example.com
HILLSTONE_PASSWORD=

# Optional. Only set this if your gateway requires SNI, which is rare --
# upstream never sends one and most gateways accept that.
# HILLSTONE_SNI=vpn.example.com
